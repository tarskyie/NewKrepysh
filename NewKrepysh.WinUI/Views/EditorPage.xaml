<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NewKrepysh.WinUI.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NewKrepysh.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:NewKrepysh.WinUI.Converters"
    xmlns:models="using:NewKrepysh.WinUI.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:NullToIsEnabledConverter x:Key="NullToIsEnabledConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto, *">
        <StackPanel Grid.Row="0">
            <SelectorBar x:Name="MainSelectionBar"
                         SelectionChanged="SelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="SelectorBarItemFile" Text="File" />
                <SelectorBarItem x:Name="SelectorBarItemMain" Text="Main" IsSelected="True"/>
                <SelectorBarItem x:Name="SelectorBarItemAi" Text="AI assistance"/>
                <SelectorBarItem x:Name="SelectorBarItemPublish" Text="Publish" />
                <SelectorBarItem x:Name="SelectorBarItemAssets" Text="Assets" />
            </SelectorBar>
            <Frame x:Name="ToolFrame" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="200, *, *">
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <StackPanel Grid.Row="0">
                    <TextBlock Margin="12,0,0,0">Pages</TextBlock>
                    <TreeView x:Name="SitePageTreeView"
            Grid.Row="0"
            ItemsSource="{x:Bind ViewModel.Pages}"
            SelectedItem="{x:Bind ViewModel.SelectedSitePage, Mode=TwoWay}"
            CanDragItems="True"
            CanReorderItems="True">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:SitePage">
                                <TreeViewItem ItemsSource="{x:Bind Children}"
                          Content="{x:Bind Title, Mode=OneWay}" />
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Margin="12,0,0,0">Assets</TextBlock>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.SelectedAsset}"
                              Height="180" />
                </StackPanel>
            </Grid>
            
            <Border Grid.Column="1" Margin="10" VerticalAlignment="Stretch">
                <ScrollView VerticalScrollBarVisibility="Visible">
                    <ContentControl IsEnabled="{x:Bind ViewModel.SelectedSitePage, Mode=OneWay, Converter={StaticResource NullToIsEnabledConverter}}"
                                    HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <TextBox Header="Title"
                                     HorizontalAlignment="Stretch"
                                     Text="{x:Bind ViewModel.SelectedSitePage.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Header="Markup body content" 
                                     Text="{x:Bind ViewModel.SelectedSitePage.HtmlContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="500"
                                     AcceptsReturn="True" IsSpellCheckEnabled="False"/>
                        </StackPanel>
                    </ContentControl>
                </ScrollView>
            </Border>

            <WebView2 x:Name="PreviewWebView2" Grid.Column="2"></WebView2>
        </Grid>
    </Grid>
</Page>
